{
  "name": "mendoza-transparente",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@mt/web",
    "build": "turbo run build --filter=@mt/web",
    "scrape": "bun packages/scrapers/src/cli.ts",
    "crudo": "bun packages/scrapers/src/inspect.ts",
    "seccion": "bun scripts/doc-section.ts",
    "typecheck": "turbo run typecheck",
    "actualizar": "bun scripts/actualizar.ts",
    "archivar": "bun packages/scrapers/src/archive-org.ts",
    "hallazgo": "bun packages/participation/src/report-finding.ts",
    "verificar": "bun scripts/verificar-web.ts",
    "medir": "bun scripts/measure-vitals.ts",
    "vista-previa": "bun scripts/vista-previa.ts",
    "novedades": "bun scripts/weekly-update.ts",
    "mascotas": "bun packages/mascots/scripts/build-assets.ts",
    "asistente:datos": "bun packages/assistant/scripts/build-knowledge.ts",
    "asistente:evals": "bun packages/assistant/scripts/run-evals.ts",
    "asistente:claves": "bun scripts/asistente-claves.ts",
    "tributos:probar": "bun packages/scrapers/src/tributos/try-reader.ts",
    "resumir-leyes": "cd apps/web && bun scripts/resumir-leyes.ts",
    "posthog-sync": "cd apps/web && bun scripts/posthog-sync.ts",
    "lint": "biome check . && bun run lint:arch",
    "lint:arch": "depcruise apps/web/src apps/web/scripts apps/panel/src apps/votacion/src packages --config .dependency-cruiser.cjs",
    "format": "biome check --write .",
    "test": "bun test",
    "hooks": "lefthook install",
    "panel": "turbo run dev --filter=@mt/panel",
    "votacion": "turbo run dev --filter=@mt/votacion",
    "piezas": "turbo run dev --filter=@mt/social",
    "pieza:filmar": "bun apps/social/vendor/stageshow/scripts/film.mjs",
    "pieza:grabar": "bun apps/social/scripts/record.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/bun": "latest",
    "dependency-cruiser": "^18.6.0",
    "lefthook": "^2.2.1",
    "playwright-core": "^1.64.0",
    "turbo": "^2",
    "typescript": "^5"
  }
}
