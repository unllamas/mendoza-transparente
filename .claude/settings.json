{
  "permissions": {
    "allow": [
      "Bash(bun run typecheck)",
      "Bash(bun run verificar)",
      "Bash(bun run data)",
      "Bash(bunx tsc --noEmit)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": ["Read(./.env.cloudflare)", "Read(./.env.posthog)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Edit|Write",
        "hooks": [{ "type": "command", "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-secrets.ts\"" }]
      }
    ]
  }
}
